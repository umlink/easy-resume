/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model resume {
  id           BigInt   @id @unique(map: "id")
  title        String   @db.VarChar(64)
  content      Json
  userId       Int      @map("user_id")
  templateCode String?  @map("template_code") @db.VarChar(32)
  dataTmp      Int      @default(0) @map("data_tmp")
  accessCode   String?  @map("access_code") @db.VarChar(32)
  exportCount  Int?     @default(0) @map("export_count")
  deleted      Int?     @default(0) @map("deleted") @db.TinyInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamp(0)

  @@index([templateCode], map: "resume_template_id_index")
  @@index([userId], map: "resume_user_id_index")
  @@index([dataTmp], map: "resume_data_tmp_index")
}
