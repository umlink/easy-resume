# resume-puppeteer 环境变量模板
# 复制为 .env.development / .env.production 并填入实际值

# AES-128-CBC 加密参数（必须与 resume-server 端一致，16 字节）
# 用于解密 PDF 导出 authCode
AES_KEY=your-aes-key-16bytes
AES_IV=your-aes-iv-16bytes

# 七牛云 OSS 凭证
QINIU_ACCESS_KEY=your-qiniu-access-key
QINIU_SECRET_KEY=your-qiniu-secret-key
QINIU_BUCKET=fresume

# 简历预览页 host（dev 用 localhost，prod 用线上域名）
# dev 默认 http://localhost:8000，prod 默认 https://www.example.com
CLIENT_HOST_PROD=https://www.example.com

# CDN host（用于拼装 PDF 上传后的访问 URL）
CDN_HOST=https://static.example.com

# PDF 文件名前缀（拼装为 `${PDF_PREFIX}${resumeId}.pdf`）
PDF_PREFIX=resume
