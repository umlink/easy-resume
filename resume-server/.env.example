NODE_ENV=development

# 启动基础配置
SERVER_PORT=8088
SERVER_HOST=0.0.0.0
SERVER_DOMAIN=https://www.example.com
API_PREFIX=/resume-api
API_ENABLED_SWAGGER=True

# jwt 登录信息
JWT_SECRET="your-jwt-secret-here"
JWT_AUTH_KEY="authorization"
JWT_EXPIRES_IN="7d"

# 加密相关
MD5_SALT="your-md5-salt-here"

# email 邮箱相关设置
MAIL_SERVER_HOST="smtp.example.com"
MAIL_SERVER_PORT=465
MAIL_SERVER_SECURE=True
MAIL_USER_EMAIL="noreply@example.com"
MAIL_AUTH_CODE="your-mail-auth-code"
MAIL_FORM_NAME="轻简历"
MAIL_FEEDBACK_TO="feedback@example.com"

# database 数据库配置
DATABASE_URL='mysql://user:password@host:port/dbname'
DATABASE_LOG_LEVEL="query,info,warn,error"

# cache 缓存设置
CACHE_HTTP_GLOBAL_TTL=300
CACHE_HTTP_GLOBAL_MAX=3600

# upload 上传配置
UPLOAD_PATH="./upload/"
UPLOAD_HOST="https://static.example.com"
UPLOAD_MAX_SIZE=2
# 七牛云
UPLOAD_QI_NIU_ACCESS_KEY="your-qiniu-access-key"
UPLOAD_QI_NIU_SECRET_KEY="your-qiniu-secret-key"
UPLOAD_QI_NIU_BUCKET="your-bucket"

# 日志设置
LOG_PATH=nestjs-logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3d

# 接口截流
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=5
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=20
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=60

# 微信小程序配置
MP_APP_ID=your-mp-app-id
MP_APP_SECRET=your-mp-app-secret

# 会员相关
VIP_GIFT_MIN_DAY=1
VIP_GIFT_MAX_DAY=3

# AI providers
AI_DEEPSEEK_API_KEY=your-deepseek-api-key
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_KIMI_API_KEY=your-kimi-api-key
AI_KIMI_BASE_URL=https://api.moonshot.cn/v1
AI_BAIDU_ACCESS_KEY=your-baidu-access-key
AI_BAIDU_SECRET_KEY=your-baidu-secret-key
AI_XF_APP_ID=your-xf-app-id
AI_XF_API_SECRET=your-xf-api-secret
AI_XF_API_KEY=your-xf-api-key

# 支付（YunGouOS）
PAY_MCH_ID=your-merchant-id
PAY_SIGN_KEY=your-pay-sign-key

# AES 简历分享加密
AES_KEY=your-aes-key-16bytes
AES_IV=your-aes-iv-16bytes

# 默认用户配置
DEFAULT_USER_AVATAR=https://static.example.com/avatar/default.jpg
# 小程序新用户默认密码，值为 Md5('123456')（不带 MD5_SALT，与邮箱注册流程不同）
DEFAULT_USER_PASSWORD=625ba44690e602e555c7fdabac33c647

# 功能开关（True/False）
EXPORT_PDF_VIP_CHECK_ENABLED=True
AI_CHECK_COUNT_ENABLED=True
AI_TOKENS_ENABLED=True
