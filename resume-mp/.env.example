# Taro 环境变量模板
# 复制为 .env.development / .env.test / .env.production 并填入实际值
# 文档：https://taro-docs.jd.com/docs/next/env-mode-config

# 微信小程序 AppID（也可在 project.config.json 中直接修改）
# TARO_APP_ID=wx0000000000000000

# 后端 API 基础地址（必填，结尾不要加斜杠）
# 例如：https://your-domain.com/resume-api
TARO_APP_BASE_URL=https://api.example.com/resume-api
